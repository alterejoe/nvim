{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "autoupdate": true,
  "default_agent": "build",

  "provider": {
    "opencode": {
      "models": {
        "big-pickle": {
          "options": {
            "reasoningEffort": "low",
            "textVerbosity": "low"
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },
            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            }
          }
        }
      }
    }
  },

  "agent": {
    "build": {
      "maxIterations": 10
    },
    "plan": {
      "maxIterations": 5
    },
    "chat": {
      "maxIterations": 3
    }
  },

  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "sudo *": "ask"
    }
  },

  "instructions": ["AGENTS.md"],

  "tui": {
    "scroll_speed": 3,
    "diff_style": "auto"
  },

  "snapshot": true,
  "share": "manual",

  "server": {
    "port": 4096,
    "hostname": "localhost"
  }
}
