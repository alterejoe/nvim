-- lua/tmux_projects/browser.lua FINAL
-- Shared Oil-style level browser built on scratchbuf.
--
-- Model (mirrors oil.nvim):
--   * One level per buffer. Rows ending in "/" are folders, other rows are
--     sessions in the "name<TAB>path" format.
--   * <CR> on a folder commits the level, closes the view and opens the child.
--   * "-" commits the level and returns to the parent.
--   * <C-l> / r refresh the current level; live tmux state is cached.
--   * dd cuts a session row, gp/gP paste it. Moving a session between folders:
--     dd at the source level, <CR> into the target folder, gp, W.
--   * The plugin owning a level provides render/commit/open_session and keeps
--     all state; this module only handles navigation and presentation.

local scratchbuf = require("scratchbuf")

local M = {}

local live_cache = nil

function M.live_sessions()
	if not live_cache then
		live_cache = {}
		for _, name in ipairs(vim.fn.systemlist("tmux list-sessions -F '#S' 2>/dev/null")) do
			live_cache[name] = true
		end
	end
	return live_cache
end

function M.invalidate_live()
	live_cache = nil
end

local function split_session(line)
	local raw = vim.trim(line)
	local name, path = raw:match("^(.-)%s+(.+)$")
	if not name then
		return raw, ""
	end
	return vim.trim(name), vim.trim(path)
end

local function is_folder(line)
	return vim.trim(line):sub(-1) == "/"
end

local function parent_of(prefix)
	if prefix == "" or prefix == nil then
		return nil
	end
	return prefix:match("^(.*)/[^/]+$") or ""
end

local function close_view(buf)
	local win = vim.fn.bufwinid(buf)
	if win ~= -1 then
		vim.api.nvim_win_close(win, true)
	end
	if vim.api.nvim_buf_is_valid(buf) then
		vim.api.nvim_buf_delete(buf, { force = true })
	end
end

function M.open_level(opts)
	local prefix = opts.prefix or ""
	local live = opts.live or M.live_sessions

	local function title()
		if prefix == "" then
			return opts.title_root or "Browser"
		end
		return (opts.title_prefix or opts.title_root or "Browser") .. " / " .. prefix
	end

	local function render()
		return opts.render(prefix)
	end

	local function navigate(child)
		M.open_level(vim.tbl_extend("force", opts, { prefix = child }))
	end

	local function commit(buf)
		local ok = opts.commit(prefix, vim.api.nvim_buf_get_lines(buf, 0, -1, false))
		if ok then
			vim.bo[buf].modified = false
		end
		return ok
	end

	local function leave(buf, target)
		vim.schedule(function()
			close_view(buf)
			navigate(target)
		end)
	end

	scratchbuf.open({
		title = title(),
		lines = render(),
		close_on_open = false,
		refresh = function()
			M.invalidate_live()
			return render()
		end,
		on_open = function(line)
			local buf = vim.api.nvim_get_current_buf()
			local raw = vim.trim(line)
			if is_folder(raw) then
				local name = vim.trim(raw:sub(1, -2))
				if name == "" then
					return
				end
				if commit(buf) then
					leave(buf, prefix == "" and name or (prefix .. "/" .. name))
				end
				return
			end
			local name, path = split_session(raw)
			if name ~= "" then
				opts.open_session(name, path, prefix)
			end
		end,
		on_save = function()
			local buf = vim.api.nvim_get_current_buf()
			local ok = commit(buf)
			if ok and opts.on_commit then
				opts.on_commit(prefix)
			end
			return ok == true
		end,
		on_ready = function(buf)
			local ns = vim.api.nvim_create_namespace("tmux_browser_" .. buf)

			local function decorate()
				vim.api.nvim_buf_clear_namespace(buf, ns, 0, -1)
				local live_set = live()
				for row, line in ipairs(vim.api.nvim_buf_get_lines(buf, 0, -1, false)) do
					local text = vim.trim(line)
					if text ~= "" then
						if is_folder(text) then
							vim.api.nvim_buf_add_highlight(buf, ns, "Directory", row - 1, 0, -1)
						else
							local name = text:match("^(.-)%s") or text
							local marker = live_set[name] and " ●" or " ○"
							local hl = live_set[name] and "DiagnosticOk" or "Comment"
							vim.api.nvim_buf_set_extmark(buf, ns, row - 1, 0, {
								virt_text = { { marker, hl } },
								virt_text_pos = "eol",
							})
						end
					end
				end
			end

			decorate()
			vim.api.nvim_create_autocmd({ "TextChanged", "TextChangedI" }, {
				buffer = buf,
				callback = decorate,
			})

			vim.keymap.set("n", "-", function()
				local parent = parent_of(prefix)
				if parent == nil then
					return
				end
				if commit(buf) then
					leave(buf, parent)
				end
			end, { buffer = buf, nowait = true, noremap = true, desc = "Parent level" })

			vim.keymap.set("n", "<C-l>", function()
				M.invalidate_live()
				vim.api.nvim_buf_set_lines(buf, 0, -1, false, render())
				vim.bo[buf].modified = false
				decorate()
			end, { buffer = buf, nowait = true, noremap = true, desc = "Refresh level" })

			local function paste(above)
				local raw = vim.fn.getreg('"')
				if raw == "" then
					vim.notify("tmux browser: register empty", vim.log.levels.WARN)
					return
				end
				local lnum = vim.api.nvim_win_get_cursor(0)[1]
				local at = above and (lnum - 1) or lnum
				vim.api.nvim_buf_set_lines(buf, at, at, false, { raw })
				vim.bo[buf].modified = true
				decorate()
			end

			vim.keymap.set("n", "gp", function()
				paste(false)
			end, { buffer = buf, nowait = true, noremap = true, desc = "Paste below" })
			vim.keymap.set("n", "gP", function()
				paste(true)
			end, { buffer = buf, nowait = true, noremap = true, desc = "Paste above" })

			if opts.on_ready then
				opts.on_ready(buf, prefix)
			end
		end,
	})
end

return M
