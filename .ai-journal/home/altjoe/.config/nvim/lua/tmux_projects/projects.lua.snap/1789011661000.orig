-- lua/tmux_projects/projects.lua FINAL
-- Oil-style project/group browser. Groups are containers; sessions are the only
-- entries that create or switch tmux sessions.

local state = require("tmux_projects.state")
local scratchbuf = require("scratchbuf")

local M_sub = {}

local function trim_path(path)
	return vim.trim(path or "")
end

local function is_group_line(line)
	return vim.trim(line):sub(-1) == "/"
end

local function split_session(line)
	local raw = vim.trim(line)
	local name, path = raw:match("^(.-)%s+(.+)$")
	if not name then
		return raw, ""
	end
	return vim.trim(name), trim_path(path)
end

local function child_key(parent, name)
	if parent == "" then
		return name
	end
	return parent .. "/" .. name
end

function M_sub.setup(M)
	local function create_session(session)
		local path = vim.fn.expand(session.path or "")
		if path == "" then
			vim.notify("tmux: no path for '" .. session.name .. "'", vim.log.levels.WARN)
			return false
		end
		if not state.session_exists(session.name) then
			state.tmux(
				"new-session -ds "
					.. vim.fn.shellescape(session.name)
					.. " -c "
					.. vim.fn.shellescape(path)
			)
		end
		return true
	end

	local function group_exists(name)
		return M.projects[name] ~= nil
	end

	local function group_children(prefix)
		local groups = {}
		local sessions = {}
		local seen_groups = {}
		local entries = M.projects[prefix] or {}

		for _, entry in ipairs(entries) do
			table.insert(sessions, entry)
		end

		local prefix_with_slash = prefix == "" and "" or prefix .. "/"
		for group_name in pairs(M.projects) do
			if group_name ~= prefix and vim.startswith(group_name, prefix_with_slash) then
				local remainder = group_name:sub(#prefix_with_slash + 1)
				if prefix == "" then
					remainder = group_name
				end
				local child = remainder:match("^([^/]+)/") or remainder
				if child ~= "" and not seen_groups[child] then
					seen_groups[child] = true
					table.insert(groups, child)
				end
			end
		end

		table.sort(groups)
		return groups, sessions
	end

	local function save_level(prefix, buf)
		local groups, old_sessions = group_children(prefix)
		local old_by_name = {}
		for _, session in ipairs(old_sessions) do
			old_by_name[session.name] = session
		end

		local new_sessions = {}
		local new_groups = {}
		for _, raw in ipairs(vim.api.nvim_buf_get_lines(buf, 0, -1, false)) do
			local line = vim.trim(raw)
			if line ~= "" then
				if is_group_line(line) then
					local name = vim.trim(line:sub(1, -2))
					if name ~= "" then
						local key = child_key(prefix, name)
						new_groups[key] = true
						M.projects[key] = M.projects[key] or {}
					end
				else
					local name, path = split_session(line)
					if name ~= "" then
						local old = old_by_name[name]
						table.insert(new_sessions, { name = name, path = path ~= "" and path or (old and old.path or "") })
					end
				end
			end
		end

		if prefix ~= "" or #new_sessions > 0 or #old_sessions > 0 then
			M.projects[prefix] = new_sessions
		end
		for _, group in ipairs(groups) do
			local key = child_key(prefix, group)
			if not new_groups[key] then
				M.projects[key] = nil
			end
		end
		M.save_overrides()
		return true
	end

	local function open_session(session)
		if session.path == "" then
			vim.notify("tmux: enter a path for '" .. session.name .. "' before opening", vim.log.levels.WARN)
			return
		end
		if create_session(session) then
			state.tmux("switch-client -t " .. vim.fn.shellescape(session.name))
		end
	end

	local function render(prefix)
		local groups, sessions = group_children(prefix)
		local lines = {}
		for _, group in ipairs(groups) do
			table.insert(lines, group .. "/")
		end
		for _, session in ipairs(sessions) do
			table.insert(lines, session.name .. "\t" .. (session.path or ""))
		end
		return lines
	end

	local function show_level(prefix, parent_buf)
		local title = prefix == "" and "Tmux Projects" or ("Tmux Projects / " .. prefix)
		local lines = render(prefix)
		local current = vim.trim(vim.fn.system("tmux display-message -p '#S' 2>/dev/null"))

		scratchbuf.open({
			title = title,
			lines = lines,
			current = current,
			refresh = function()
				return render(prefix)
			end,
			on_open = function(line)
				local raw = vim.trim(line)
				if is_group_line(raw) then
					local name = vim.trim(raw:sub(1, -2))
					show_level(child_key(prefix, name))
					return
				end
				local name, path = split_session(raw)
				open_session({ name = name, path = path })
			end,
			on_save = function()
				return save_level(prefix, vim.api.nvim_get_current_buf())
			end,
			on_ready = function(buf)
				local ns = vim.api.nvim_create_namespace("tmux_project_browser")
				local function decorate()
					vim.api.nvim_buf_clear_namespace(buf, ns, 0, -1)
					for row, line in ipairs(vim.api.nvim_buf_get_lines(buf, 0, -1, false)) do
						if is_group_line(line) then
							vim.api.nvim_buf_add_highlight(buf, ns, "Directory", row - 1, 0, -1)
						end
					end
				end
				decorate()
				vim.api.nvim_create_autocmd({ "TextChanged", "TextChangedI" }, { buffer = buf, callback = decorate })

				vim.keymap.set("n", "-", function()
					if prefix == "" then
						return
					end
					vim.api.nvim_buf_delete(buf, { force = true })
					local parent = prefix:match("^(.*)/[^/]+$") or ""
					show_level(parent)
				end, { buffer = buf, nowait = true, noremap = true, desc = "Go to parent group" })

				vim.keymap.set("n", "<C-l>", function()
					local cursor = vim.api.nvim_win_get_cursor(0)
					vim.api.nvim_buf_set_lines(buf, 0, -1, false, render(prefix))
					vim.api.nvim_win_set_cursor(0, { math.min(cursor[1], vim.api.nvim_buf_line_count(buf)), cursor[2] })
					vim.bo[buf].modified = false
					decorate()
				end, { buffer = buf, nowait = true, noremap = true, desc = "Refresh project level" })
			end,
		})
	end

	function M.open_project(name)
		local sessions = M.projects[name]
		if not sessions then
			vim.notify("tmux: unknown project '" .. name .. "'", vim.log.levels.ERROR)
			return
		end
		local slots = {}
		for _, session in ipairs(sessions) do
			if create_session(session) then
				table.insert(slots, session.name)
			end
		end
		for _, session in ipairs(M.default) do
			create_session(session)
			table.insert(slots, session.name)
		end
		M.save_order(slots)
		M.set_active_project(name)
		if #slots > 0 then
			state.tmux("switch-client -t " .. vim.fn.shellescape(slots[1]))
		end
		vim.notify("Project loaded: " .. name, vim.log.levels.INFO)
	end

	function M.switch_project(name)
		M.open_project(name)
		local keep = {}
		for _, session in ipairs(M.default) do
			keep[session.name] = true
		end
		for _, session in ipairs(M.projects[name] or {}) do
			keep[session.name] = true
		end
		for _, session in ipairs(vim.fn.systemlist("tmux list-sessions -F '#S' 2>/dev/null")) do
			if not keep[session] then
				vim.fn.system("tmux kill-session -t=" .. vim.fn.shellescape(session) .. " 2>/dev/null")
			end
		end
	end

	function M.recover_project()
		local active = M.get_active_project()
		if active and M.projects[active] then
			M.open_project(active)
		else
			vim.notify("tmux: no active project to recover", vim.log.levels.WARN)
		end
	end

	function M.pick_project()
		if not state.in_tmux() then
			vim.notify("tmux: project browser opened outside tmux; switching is disabled", vim.log.levels.WARN)
		end
		show_level("")
	end
end

return M_sub
