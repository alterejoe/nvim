{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "maxIterations": 2,
      "options": {
        "reasoningEffort": "low",
        "textVerbosity": "low"
      }
    },
    "plan": {
      "maxIterations": 1,
      "options": {
        "reasoningEffort": "low",
        "textVerbosity": "low"
      }
    },
    "chat": {
      "maxIterations": 1,
      "options": {
        "reasoningEffort": "low",
        "textVerbosity": "low"
      }
    },
    "oracle": {
      "options": {
        "reasoningEffort": "low",
        "textVerbosity": "low"
      }
    }
  },
  "autoupdate": true,
  "default_agent": "oracle",
  "instructions": [
    "AGENTS.md",
    "/home/jmeyer/.config/opencode/prepends/output-formatting.md",
    "/home/jmeyer/.config/opencode/prepends/convention-tracker.md",
    "/home/jmeyer/.config/opencode/prepends/consultation-first.md"
  ],
  "mcp": {
    "engram": {
      "command": [
        "/home/linuxbrew/.linuxbrew/bin/engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "model": "opencode-go/deepseek-v4-flash",
  "permission": {
    "edit": "deny",
    "write": "deny",
    "bash": "deny",
    "task": "deny",
    "webfetch": "allow",
    "doom_loop": "deny",
    "external_directory": {
      "~/docs/**": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "envs/**": "deny",
      "**/envs/**": "deny"
    }
  },
  "plugin": [
    "opencode-ignore",
    "manage",
    "opencode-mem",
    "oh-my-openagent",
    "opencode-plugin-openspec",
    "opencode-see-image@1.3.2"
  ],
  "provider": {
    "opencode": {
      "models": {
        "big-pickle": {
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },
            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            }
          }
        }
      }
    }
  },
  "server": {
    "port": 4096,
    "hostname": "localhost"
  },
  "share": "manual",
  "snapshot": true
}
