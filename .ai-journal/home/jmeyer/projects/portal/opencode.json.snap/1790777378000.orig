{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "permission": {
    "edit": "deny",
    "bash": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },

    "external_directory": {
      "/home/jmeyer/projects/portal/**": "allow",
      "/home/jmeyer/projects/programmer-tools/**": "allow"
    }
  },
  "plugin": ["opencode-ignore"],
  "snapshot": false
}
