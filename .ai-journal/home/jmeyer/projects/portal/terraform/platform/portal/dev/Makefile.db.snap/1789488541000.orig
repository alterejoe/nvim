# Makefile.db
INFISICAL_ENV ?= staging
INFISICAL_TF_PATH ?= /terraform
DB_PATH ?= /databases
ROLES_PATH ?= /roles

.PHONY: db-sync-from-terraform db-shell db-migrate-status db-migrate-force db-migrate-up db-fix-dirty db-help

# Sync database credentials from Terraform to Infisical /databases path
db-sync-from-terraform:
	@echo "Extracting database credentials from Terraform state..."
	@infisical run --env $(INFISICAL_ENV) --path $(INFISICAL_TF_PATH) -- bash -c ' \
		DB_HOST=$$(terraform output -raw portal_db_host); \
		DB_PORT=$$(terraform output -raw portal_db_port); \
		DB_NAME=$$(terraform output -raw portal_db_name); \
		DB_USER="migrator"; \
		DB_SCHEMA="clerk"; \
		echo "Setting secrets in Infisical /databases..."; \
		echo "  DB_HOST=$$DB_HOST"; \
		echo "  DB_PORT=$$DB_PORT"; \
		echo "  DB_NAME=$$DB_NAME"; \
		infisical secrets set DB_HOST="$$DB_HOST" --env $(INFISICAL_ENV) --path $(DB_PATH); \
		infisical secrets set DB_PORT="$$DB_PORT" --env $(INFISICAL_ENV) --path $(DB_PATH); \
		infisical secrets set DB_NAME="$$DB_NAME" --env $(INFISICAL_ENV) --path $(DB_PATH); \
		infisical secrets set DB_USER="$$DB_USER" --env $(INFISICAL_ENV) --path $(DB_PATH); \
		infisical secrets set DB_SCHEMA="$$DB_SCHEMA" --env $(INFISICAL_ENV) --path $(DB_PATH); \
	'
	@echo "✓ Database credentials synced to Infisical"
	@echo ""
	@echo "Note: DB_PASS must be set manually:"
	@echo "  infisical secrets get MIGRATOR_PASSWORD --env $(INFISICAL_ENV) --path $(INFISICAL_TF_PATH) --plain | xargs -I {} infisical secrets set DB_PASS={} --env $(INFISICAL_ENV) --path $(DB_PATH)"

# /home/jmeyer/projects/portal/terraform/platform/portal/dev/Makefile.db:34 FINAL
db-shell:
	@echo "Connecting to database..."
	@infisical run --env $(INFISICAL_ENV) --path /dblab_branch -- \
		infisical run --env $(INFISICAL_ENV) --path /roles -- bash -c \
		'psql "postgres://client_runtime:$$CLIENT_RUNTIME_PASSWORD@$$DB_HOST:$$DB_PORT/$$DB_NAME?sslmode=disable"'

# Check migration status
db-migrate-status:
	@echo "Checking migration status..."
	@infisical run --env $(INFISICAL_ENV) --path $(DB_PATH) -- bash -c \
		'psql "postgres://$$DB_USER:$$DB_PASS@$$DB_HOST:$$DB_PORT/$$DB_NAME?sslmode=require" -c "SET search_path TO $$DB_SCHEMA; SELECT version, dirty FROM schema_migrations;"'

# Fix dirty migration state
db-fix-dirty:
	@echo "Fixing dirty migration state..."
	@infisical run --env $(INFISICAL_ENV) --path $(DB_PATH) -- bash -c \
		'psql "postgres://$$DB_USER:$$DB_PASS@$$DB_HOST:$$DB_PORT/$$DB_NAME?sslmode=require" -c "SET search_path TO $$DB_SCHEMA; UPDATE schema_migrations SET dirty = false WHERE dirty = true;"'
	@echo "✓ Dirty state cleared"

# Force migration to version 0
db-migrate-force:
	@echo "Forcing migration to version 0..."
	@infisical run --env $(INFISICAL_ENV) --path $(DB_PATH) -- bash -c \
		'docker run --rm registry.digitalocean.com/harp-repository/portalmigration:latest -path /migrations -database "postgres://$$DB_USER:$$DB_PASS@$$DB_HOST:$$DB_PORT/$$DB_NAME?sslmode=require&search_path=$$DB_SCHEMA" force 0'
	@echo "✓ Migration state reset"

db-migrate-up:
	@echo "Running migrations..."
	@infisical run --env $(INFISICAL_ENV) --path $(ROLES_PATH) -- \
		infisical run --env $(INFISICAL_ENV) --path $(DB_PATH) -- bash -c \
		'docker run --rm registry.digitalocean.com/harp-repository/portalmigration:latest -path /migrations -database "postgres://$$DB_USER:$$MIGRATOR_PASSWORD@$$DB_HOST:$$DB_PORT/$$DB_NAME?sslmode=require&search_path=$$DB_SCHEMA" up'
	@echo "✓ Migrations complete"

db-migrate-down:
	@echo "Rolling back one migration..."
	@infisical run --env $(INFISICAL_ENV) --path $(ROLES_PATH) -- \
		infisical run --env $(INFISICAL_ENV) --path $(DB_PATH) -- bash -c \
		'docker run --rm registry.digitalocean.com/harp-repository/portalmigration:latest -path /migrations -database "postgres://$$DB_USER:$$MIGRATOR_PASSWORD@$$DB_HOST:$$DB_PORT/$$DB_NAME?sslmode=require&search_path=$$DB_SCHEMA" down 1'
	@echo "✓ Rolled back one migration"

db-help:
	@echo "Database Management Commands:"
	@echo "  make db-sync-from-terraform - Extract DB creds from Terraform and sync to Infisical"
	@echo "  make db-shell               - Open psql shell"
	@echo "  make db-migrate-status      - Check migration status"
	@echo "  make db-fix-dirty           - Clear dirty migration flags"
	@echo "  make db-migrate-force       - Force migration version 0"
	@echo "  make db-migrate-up          - Run migrations"
