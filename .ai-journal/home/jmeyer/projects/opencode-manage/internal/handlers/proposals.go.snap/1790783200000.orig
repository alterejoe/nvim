// Package handlers mounts the daemon's tool endpoints. M6: proposals
// validate/append. M7: event-recording middleware on /v1/* requests and
// the /v1/events/rollup endpoint. M8: work-items list/context/suggestions.
package handlers

import (
	"database/sql"
	"encoding/json"
	"net/http"
	"os"
	"path/filepath"
	"strings"
	"time"

	"github.com/go-chi/chi/v5"

	"github.com/alterejoe/opencode-manage/internal/proposals"
	"github.com/alterejoe/opencode-manage/internal/store"
)

// Mount registers all daemon endpoints on the router.
func Mount(r chi.Router, db *sql.DB) {
	q := store.New(db)
	r.Use(eventRecorder(q))
	mountWorkItems(r, db)
mountRead(r, db)

	r.Post("/v1/proposals/validate", func(w http.ResponseWriter, r *http.Request) {
		var req struct {
			Path      string `json:"path"`
			Operation string `json:"operation"`
			Content   string `json:"content"`
		}
		if !decode(w, r, &req) {
			return
		}
		res, err := proposals.ValidateProposalTarget(proposals.Proposal{
			Path:      req.Path,
			Operation: req.Operation,
			Content:   req.Content,
		})
		if err != nil {
			fail(w, http.StatusUnprocessableEntity, err.Error())
			return
		}
		writeJSON(w, http.StatusOK, map[string]any{"ok": true, "mkdirs": res.Mkdirs})
	})

	r.Post("/v1/proposals", func(w http.ResponseWriter, r *http.Request) {
		var req struct {
			Directory string          `json:"directory"`
			SessionID string          `json:"session_id"`
			Row       json.RawMessage `json:"row"`
		}
		if !decode(w, r, &req) {
			return
		}
		var row struct {
			Path      string `json:"path"`
			Operation string `json:"operation"`
			Content   string `json:"content"`
		}
		if err := json.Unmarshal(req.Row, &row); err != nil {
			fail(w, http.StatusUnprocessableEntity, "[manage] proposal row is not valid JSON: "+err.Error())
			return
		}
		res, err := proposals.ValidateProposalTarget(proposals.Proposal{
			Path:      row.Path,
			Operation: row.Operation,
			Content:   row.Content,
		})
		if err != nil {
			fail(w, http.StatusUnprocessableEntity, err.Error())
			return
		}
		mkdirsJSON, err := json.Marshal(res.Mkdirs)
		if err != nil {
			fail(w, http.StatusInternalServerError, "[manage] could not encode mkdirs: "+err.Error())
			return
		}
		if _, err := q.AppendProposal(r.Context(), store.AppendProposalParams{
			SessionID: req.SessionID,
			Path:      row.Path,
			Operation: row.Operation,
			Content:   row.Content,
			Mkdirs:    string(mkdirsJSON),
		}); err != nil {
			fail(w, http.StatusInternalServerError, "[manage] could not insert the proposal: "+err.Error())
			return
		}
		// The nvim review console reads the JSONL file; the daemon is the
		// trusted writer. The AI still has no file path.
		if req.Directory != "" {
			if err := appendJSONL(req.Directory, req.SessionID, req.Row); err != nil {
				fail(w, http.StatusInternalServerError, "[manage] could not append the JSONL row: "+err.Error())
				return
			}
		}
		writeJSON(w, http.StatusOK, map[string]any{"ok": true, "mkdirs": res.Mkdirs})
	})

	r.Get("/v1/events/rollup", func(w http.ResponseWriter, r *http.Request) {
		rows, err := q.RollupEvents(r.Context())
		if err != nil {
			fail(w, http.StatusInternalServerError, "[manage] rollup query failed: "+err.Error())
			return
		}
		writeJSON(w, http.StatusOK, rows)
	})
}

// eventRecorder records every /v1/* request into the events table:
// tool (path), outcome (ok/refused), latency. Fire-and-forget: a metrics
// failure must never fail the tool call.
func eventRecorder(q *store.Queries) func(http.Handler) http.Handler {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			start := time.Now()
			rec := &statusWriter{ResponseWriter: w, status: http.StatusOK}
			next.ServeHTTP(rec, r)
			if !strings.HasPrefix(r.URL.Path, "/v1/") {
				return
			}
			outcome := "ok"
			if rec.status >= 400 {
				outcome = "refused"
			}
			_ = q.RecordEvent(r.Context(), store.RecordEventParams{
				SessionID: r.Header.Get("X-Manage-Session"),
				Tool:      r.URL.Path,
				Outcome:   outcome,
				LatencyMs: time.Since(start).Milliseconds(),
				Detail:    http.StatusText(rec.status),
			})
		})
	}
}

// statusWriter captures the response status for the recorder.
type statusWriter struct {
	http.ResponseWriter
	status int
}

func (s *statusWriter) WriteHeader(code int) {
	s.status = code
	s.ResponseWriter.WriteHeader(code)
}

func decode(w http.ResponseWriter, r *http.Request, v any) bool {
	if err := json.NewDecoder(r.Body).Decode(v); err != nil {
		fail(w, http.StatusUnprocessableEntity, "[manage] request body is not valid JSON: "+err.Error())
		return false
	}
	return true
}

func writeJSON(w http.ResponseWriter, status int, v any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	_ = json.NewEncoder(w).Encode(v)
}

func fail(w http.ResponseWriter, status int, msg string) {
	writeJSON(w, status, map[string]any{"error": msg})
}

// appendJSONL appends one raw JSON row line to the session queue file.
func appendJSONL(directory, sessionID string, row json.RawMessage) error {
	dir := filepath.Join(directory, ".ai-proposals")
	if err := os.MkdirAll(dir, 0o755); err != nil {
		return err
	}
	f, err := os.OpenFile(filepath.Join(dir, sessionID+".jsonl"), os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)
	if err != nil {
		return err
	}
	defer f.Close()
	_, err = f.Write(append(row, '\n'))
	return err
}
