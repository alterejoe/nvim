import { appendProposal } from "../proposals"

interface GrepArgs {
  pattern: string
  path?: string
  include?: string
  output_mode?: "content" | "files_with_matches" | "count"
  head_limit?: number
}

interface ToolContext {
  sessionID?: string
  directory?: string
}

function dirname(p: string): string {
  const i = p.lastIndexOf("/")
  return i > 0 ? p.slice(0, i) : "/"
}

// findPendingApproval returns true if a pending folder-approve row for this
// path already exists in the session journal (dedup — one proposal per path).
async function findPendingApproval(
  directory: string,
  sessionID: string,
  path: string,
): Promise<boolean> {
  try {
    const fs = await import("node:fs")
    const file = `${directory}/.ai-proposals/${sessionID}.jsonl`
    if (!fs.existsSync(file)) return false
    const rows = fs.readFileSync(file, "utf8").split("\n")
    for (const row of rows) {
      if (!row.trim()) continue
      try {
        const p = JSON.parse(row)
        if (
          p.operation === "folder-approve" &&
          p.path === path &&
          p.status === "pending"
        ) {
          return true
        }
      } catch {
        /* skip malformed rows */
      }
    }
  } catch {
    /* journal unreadable — allow re-emit */
  }
  return false
}

export const grepTool = (directory: string) => ({
  name: "grep",
  description:
    "Search file contents using a regular expression, gated by the manage daemon. Project-internal searches are allowed except sensitive files (*.env, *.env.*, *.pem, *.key, envs/**). External searches emit a folder-approval proposal for the user to accept or reject in the review console (<leader>ap), then retry.",
  parameters: {
    type: "object",
    properties: {
      pattern: {
        type: "string",
        description: "The regular expression to search for in file contents.",
      },
      path: {
        type: "string",
        description: "The directory to search in. Defaults to the current working directory.",
      },
      include: {
        type: "string",
        description: "File pattern to include in the search (e.g. '*.js').",
      },
      output_mode: {
        type: "string",
        enum: ["content", "files_with_matches", "count"],
        description: "Output mode: content (default), files_with_matches, or count.",
      },
      head_limit: {
        type: "number",
        description: "Limit output to the first N entries (default 100).",
      },
    },
    required: ["pattern"],
  },
  async execute(args: GrepArgs, context: ToolContext) {
    const res = await daemonRequest("POST", "/v1/grep", JSON.stringify({
      pattern: args.pattern,
      path: args.path ?? directory,
      include: args.include,
      output_mode: args.output_mode ?? "content",
      head_limit: args.head_limit ?? 0,
    }))
    if (res.status === 200) {
      const data = JSON.parse(res.body)
      return formatMatches(data.matches ?? [], args.output_mode ?? "content")
    }
    let body: any = {}
    try {
      body = JSON.parse(res.body)
    } catch {
      /* non-JSON error body */
    }
    if (res.status === 403 && body.needsApproval) {
      const sessionID = context?.sessionID ?? ""
      const approvePath: string = body.path ?? dirname(args.path ?? directory)
      const existing = await findPendingApproval(directory, sessionID, approvePath)
      if (!existing) {
        await appendProposal(directory, sessionID, {
          operation: "folder-approve",
          path: approvePath,
          content: approvePath,
          reason: `grep of ${args.path ?? directory} requires folder approval`,
          group: "read-folder-approval",
          ts: Date.now(),
          status: "pending",
        })
      }
      return `grep denied: ${args.path ?? directory} is outside the project and not covered by an approved folder. A folder-approval proposal for ${approvePath} has been emitted — accept or reject it in the review console (<leader>ap), then retry.`
    }
    throw new Error(body.error ?? `grep failed (${res.status})`)
  },
})

function formatMatches(matches: any[], mode: string): string {
  if (mode === "count") {
    return matches.map((m) => `${m.path}: ${m.count}`).join("\n")
  }
  if (mode === "files_with_matches") {
    return matches.map((m) => m.path).join("\n")
  }
  return matches.map((m) => `${m.path}:${m.line}: ${m.content}`).join("\n")
}

import { daemonRequest } from "../daemon"
